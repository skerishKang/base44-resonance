{"name":"WatchTreeFingerprint","description":"Bounded deterministic owner-visible WatchTree summary. Internal deduplication fields (input_digest) are stripped from all browser-facing responses.","type":"object","properties":{"import_id":{"type":"string","minLength":1,"maxLength":128},"normalization_version":{"type":"string","minLength":1,"maxLength":32},"matching_version":{"type":"string","minLength":1,"maxLength":32},"eligible_event_count":{"type":"integer","minimum":0,"maximum":25000},"unique_content_count":{"type":"integer","minimum":0,"maximum":25000},"creator_clusters":{"type":"array","minItems":0,"maxItems":50,"items":{"type":"object","properties":{"label":{"type":"string","minLength":0,"maxLength":160},"count":{"type":"integer","minimum":0,"maximum":25000},"unique":{"type":"integer","minimum":0,"maximum":25000}},"required":["label","count","unique"]}},"repeat_signal_count":{"type":"integer","minimum":0,"maximum":25000},"viewing_rhythm":{"type":"array","minItems":28,"maxItems":28,"items":{"type":"number","minimum":0,"maximum":1}},"rarity_signal_count":{"type":"integer","minimum":0,"maximum":25000},"excluded_count":{"type":"integer","minimum":0,"maximum":25000},"stale":{"type":"boolean","default":false},"is_synthetic":{"type":"boolean","default":false},"generated_at":{"type":"string","minLength":20,"maxLength":40},"schema_version":{"type":"integer","minimum":1,"maximum":1}},"required":["import_id","normalization_version","matching_version","eligible_event_count","unique_content_count","creator_clusters","repeat_signal_count","viewing_rhythm","rarity_signal_count","excluded_count","stale","is_synthetic","generated_at","schema_version"],"rls":{"create":{"$or":[{"user_condition":{"role":"user"}},{"user_condition":{"role":"admin"}}]},"read":{"created_by_id":"{{user.id}}"},"update":{"created_by_id":"{{user.id}}"},"delete":{"created_by_id":"{{user.id}}"}}}
