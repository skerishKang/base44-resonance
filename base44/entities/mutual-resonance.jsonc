{"name":"MutualResonance","description":"Explicitly simulated mutual state for the competition synthetic corpus. Internal deduplication fields (source_digest) are stripped from all browser-facing responses.","type":"object","properties":{"candidate_id":{"type":"string","minLength":1,"maxLength":128},"candidate_ref_opaque":{"type":"string","minLength":1,"maxLength":128},"state":{"type":"string","minLength":1,"maxLength":16,"enum":["pending","mutual","revoked","expired"]},"revealed_items":{"type":"array","minItems":0,"maxItems":10,"items":{"type":"object","properties":{"evidence_type":{"type":"string","minLength":1,"maxLength":32},"label":{"type":"string","minLength":1,"maxLength":64},"count":{"type":"integer","minimum":0,"maximum":5000}},"required":["evidence_type","label","count"]}},"mutual_at":{"type":"string","minLength":0,"maxLength":40},"revoked_at":{"type":"string","minLength":0,"maxLength":40},"simulation_label":{"type":"string","minLength":1,"maxLength":80},"consent_version":{"type":"string","minLength":1,"maxLength":64},"is_simulated":{"type":"boolean","default":true},"schema_version":{"type":"integer","minimum":1,"maximum":1}},"required":["candidate_id","candidate_ref_opaque","state","revealed_items","simulation_label","consent_version","is_simulated","schema_version"],"rls":{"create":{"$or":[{"user_condition":{"role":"user"}},{"user_condition":{"role":"admin"}}]},"read":{"created_by_id":"{{user.id}}"},"update":{"created_by_id":"{{user.id}}"},"delete":{"created_by_id":"{{user.id}}"}}}
