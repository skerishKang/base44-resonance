{"name":"WatchMatchSignal","description":"Internal-only backend deduplication signal. Not accessible from any browser code path. HMAC-SHA256 fingerprint for content-based matching without exposing raw hashes.","type":"object","properties":{"import_id":{"type":"string","minLength":1,"maxLength":128},"match_key":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[a-f0-9]+$"},"record_key":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[a-f0-9]+$"},"normalized_content_id":{"type":"string","minLength":1,"maxLength":128},"watched_at":{"type":"string","minLength":20,"maxLength":40},"schema_version":{"type":"integer","minimum":1,"maximum":1}},"required":["import_id","match_key","record_key","normalized_content_id","watched_at","schema_version"],"rls":{"create":{"$or":[{"user_condition":{"role":"user"}},{"user_condition":{"role":"admin"}}]},"read":{"created_by_id":"{{user.id}}"},"update":{"created_by_id":"{{user.id}}"},"delete":{"created_by_id":"{{user.id}}"}}}
