{"name":"RevealConsent","description":"Explicit owner consent for selected synthetic candidate evidence.","type":"object","properties":{"candidate_id":{"type":"string","minLength":1,"maxLength":128},"candidate_ref_opaque":{"type":"string","minLength":1,"maxLength":128},"selected_evidence_tokens":{"type":"array","minItems":0,"maxItems":10,"items":{"type":"string","minLength":1,"maxLength":128}},"state":{"type":"string","minLength":1,"maxLength":16,"enum":["pending","granted","revoked","expired"]},"consent_version":{"type":"string","minLength":1,"maxLength":64},"client_nonce":{"type":"string","minLength":8,"maxLength":80,"pattern":"^[A-Za-z0-9_-]+$"},"granted_at":{"type":"string","minLength":0,"maxLength":40},"revoked_at":{"type":"string","minLength":0,"maxLength":40},"is_synthetic":{"type":"boolean","default":true},"schema_version":{"type":"integer","minimum":1,"maximum":1}},"required":["candidate_id","candidate_ref_opaque","selected_evidence_tokens","state","consent_version","client_nonce","is_synthetic","schema_version"],"rls":{"create":{"$or":[{"user_condition":{"role":"user"}},{"user_condition":{"role":"admin"}}]},"read":{"created_by_id":"{{user.id}}"},"update":{"created_by_id":"{{user.id}}"},"delete":{"created_by_id":"{{user.id}}"}}}
