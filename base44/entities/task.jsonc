{
  "name": "Task",
  "description": "Legacy scaffold dependency retained because base44/agents is outside Slice 1 allowed paths. No Task UI remains.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Legacy task title"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Legacy completion state"
    }
  },
  "required": ["title"],
  "rls": {
    "create": { "user_condition": { "id": "{{user.id}}" } },
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
