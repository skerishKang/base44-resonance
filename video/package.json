    "remotion": "4.0.495"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.495",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
