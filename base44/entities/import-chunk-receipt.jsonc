{"name":"ImportChunkReceipt","description":"Owner-scoped chunk receipt used to resume and deduplicate durable import writes.","type":"object","properties":{"import_id":{"type":"string","minLength":1,"maxLength":128},"chunk_index":{"type":"integer","minimum":0,"maximum":200},"total_chunks":{"type":"integer","minimum":1,"maximum":200},"chunk_digest":{"type":"string","minLength":16,"maxLength":128},"record_count":{"type":"integer","minimum":0,"maximum":200},"status":{"type":"string","minLength":1,"maxLength":20,"enum":["committed","failed","compensated"]},"client_nonce":{"type":"string","minLength":8,"maxLength":96,"pattern":"^[A-Za-z0-9_-]+$"},"schema_version":{"type":"integer","minimum":1,"maximum":1}},"required":["import_id","chunk_index","total_chunks","chunk_digest","record_count","status","client_nonce","schema_version"],"rls":{"create":{"$or":[{"user_condition":{"role":"user"}},{"user_condition":{"role":"admin"}}]},"read":{"created_by_id":"{{user.id}}"},"update":{"created_by_id":"{{user.id}}"},"delete":{"created_by_id":"{{user.id}}"}}}
