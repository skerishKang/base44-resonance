{"name":"WatchEvent","description":"One caller-owned normalized viewing occurrence. Raw source records are never stored.","type":"object","properties":{"source_platform":{"type":"string","minLength":1,"maxLength":32,"enum":["youtube","synthetic_demo"]},"source_type":{"type":"string","minLength":1,"maxLength":40,"enum":["synthetic_demo","google_takeout_json","google_takeout_html"]},"normalized_content_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9:_-]+$"},"match_hash":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[a-f0-9]+$"},"bounded_title":{"type":"string","minLength":1,"maxLength":240},"bounded_creator_label":{"type":"string","minLength":0,"maxLength":160},"canonical_public_url":{"type":"string","minLength":0,"maxLength":512},"watched_at":{"type":"string","minLength":20,"maxLength":40},"repeat_count":{"type":"integer","minimum":1,"maximum":999},"first_watched_at":{"type":"string","minLength":20,"maxLength":40},"last_watched_at":{"type":"string","minLength":20,"maxLength":40},"occurrence_index":{"type":"integer","minimum":1,"maximum":999},"same_second_ordinal":{"type":"integer","minimum":0,"maximum":99},"visibility_state":{"type":"string","minLength":1,"maxLength":32,"enum":["owner_only","matchable_private","reveal_selected"]},"matching_enabled":{"type":"boolean","default":false},"sensitivity_excluded":{"type":"boolean","default":false},"exclusion_reason":{"type":"string","minLength":0,"maxLength":64,"enum":["","item","creator","date_range","import_disabled","deleted_unavailable","user_other"],"default":""},"optional_owner_note":{"type":"string","minLength":0,"maxLength":500},"import_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9_-]+$"},"normalization_version":{"type":"string","minLength":1,"maxLength":32,"pattern":"^[a-z0-9._-]+$"},"canonicalization_version":{"type":"string","minLength":1,"maxLength":32,"pattern":"^[a-z0-9._-]+$"},"source_record_fingerprint":{"type":"string","minLength":16,"maxLen